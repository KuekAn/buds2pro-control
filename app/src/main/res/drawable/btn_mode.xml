<?xml version="1.0" encoding="utf-8"?>
<!-- selected = current mode; activated = only one bud in ear (calm teal). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33888888">
    <item>
        <selector>
            <item android:state_selected="true" android:state_activated="true">
                <shape android:shape="rectangle"><solid android:color="@color/single" /><corners android:radius="22dp" /></shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle"><solid android:color="@color/accent" /><corners android:radius="22dp" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><solid android:color="@color/pill_off" /><corners android:radius="22dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
