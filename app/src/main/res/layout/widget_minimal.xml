<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal 1x1 tile: mode name and lowest battery, no fill colour. Tap cycles the mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/m_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="4dp"
    android:background="@drawable/minimal_bg">
    <TextView android:id="@+id/m_mode" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="Buds" android:textColor="@color/glass_text"
        android:textSize="14sp" android:textStyle="bold" android:maxLines="1"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp" />
    <TextView android:id="@+id/m_batt" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/glass_text_dim" android:textSize="10sp" android:maxLines="1" />
</LinearLayout>
