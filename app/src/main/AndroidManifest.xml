<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet is used only by Updater: checking this app's public GitHub repo for a
         newer APK, on request or once a day if the user turns that on. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Global (session 0) equaliser. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Lets the EQ page show music apps by name (launcher apps only). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".TouchActivity" android:exported="false" />
        <activity android:name=".FindActivity" android:exported="false" />
        <activity android:name=".MoreActivity" android:exported="false" />
        <activity android:name=".EqActivity" android:exported="false" />

        <service android:name=".UpdateJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".InstallReceiver" android:exported="false" />

        <service android:name=".EqService" android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".BudsService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BudsWidget"
            android:exported="true"
            android:label="@string/widget_full">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_buds_info" />
        </receiver>

        <receiver
            android:name=".ModeWidget"
            android:exported="true"
            android:label="@string/widget_mode">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mode_info" />
        </receiver>
    </application>
</manifest>
